#!/bin/sh
set -e

case "$1" in
  configure)
    if ! getent group uinput >/dev/null 2>&1; then
      addgroup --system uinput >/dev/null 2>&1 || true
    fi

    if command -v udevadm >/dev/null 2>&1; then
      udevadm control --reload-rules || true
      udevadm trigger --subsystem-match=input --action=change || true
      udevadm trigger --sysname-match=uinput --action=change || true
    fi

    if command -v modprobe >/dev/null 2>&1; then
      modprobe uinput || true
    fi

    echo "keyswap installed; see /usr/share/doc/keyswap/README.Debian for setup instructions."
    ;;
esac

#DEBHELPER#
exit 0
