# Python
__pycache__/
*.pyc

# Local caches
.depcache/

# Debian build output inside source tree
/debian/.debhelper/
/debian/debhelper-build-stamp
/debian/files
/debian/tmp/
/debian/keyswap/
/debian/*.substvars
/debian/*.debhelper

# Debian package artifacts in source tree
*.build
*.buildinfo
*.changes
*.deb
*.dsc
*.log
*.orig.tar.*

# Debian package artifacts generated by dpkg-buildpackage one level above
../keyswap_*.build
../keyswap_*.buildinfo
../keyswap_*.changes
../keyswap_*.deb
../keyswap_*.dsc
../keyswap_*.tar.*
